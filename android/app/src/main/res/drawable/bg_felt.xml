<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Felt / fleece surface, tiled at native density -->
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/felt_texture"
            android:tileMode="repeat" />
    </item>

    <!-- Soft vignette so the centre of the screen stays calm -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#22000000"
                android:centerX="0.5"
                android:centerY="0.32"
                android:endColor="#99000000"
                android:gradientRadius="78%p"
                android:startColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
